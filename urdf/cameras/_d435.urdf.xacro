<?xml version="1.0"?>
<!-- RealSense D435 攝像頭 URDF 宏（從 realsense2_description 合併到 openarm_description）
     簡化設計：直接將 camera_link 附加到 parent，無中間 bottom_screw_frame，
     與 cameras.launch.py 中的 static_transform_publisher TF 結構一致。
     mesh 使用 realsense2_description 的真實 D435 模型。 -->
<robot name="sensor_d435" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find openarm_description)/urdf/cameras/_materials.urdf.xacro" />

  <xacro:macro name="sensor_d435" params="parent *origin name:=camera">
    <xacro:property name="M_PI" value="3.1415926535897931" />

    <!-- D435 攝像頭尺寸（來自 realsense2_description） -->
    <xacro:property name="d435_cam_width" value="0.090" />
    <xacro:property name="d435_cam_height" value="0.025" />
    <xacro:property name="d435_cam_depth" value="0.02505" />
    <xacro:property name="d435_cam_mount_from_center_offset" value="0.0149" />

    <!-- camera_link 直接附加到 parent，與 static TF 一致 -->
    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${name}_link" />
    </joint>

    <link name="${name}_link">
      <visual>
        <!-- mesh 定位：相對於 camera_link 的偏移，與 realsense2_description 原始絕對位置一致 -->
        <origin xyz="${d435_cam_mount_from_center_offset} 0 ${d435_cam_height/2}" rpy="${M_PI/2} 0 ${M_PI/2}" />
        <geometry>
          <mesh filename="package://openarm_description/meshes/cameras/d435.stl" />
        </geometry>
        <material name="aluminum" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${d435_cam_depth} ${d435_cam_width} ${d435_cam_height}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.072" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257" />
      </inertial>
    </link>
  </xacro:macro>
</robot>
