<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ROHand 灵巧手默认参数（与 openarm_hand_arguments.xacro 同风格，
       名称加 rohand_ 前缀以便 both 模式下与夹爪参数共存） -->

  <!-- 灵巧手基座相对 link7 的平移偏置。
       灵巧手安装在 link7 顶部工具法兰（第 8 轴安装面）上，与原第 8 轴（夹爪
       电机/夹爪）同一安装面：
       - link7 mesh 顶面（远端工具法兰）z=654.0mm，mesh 原点相对 link7 系
         z=-0.5585m（kinematics_link.yaml link7），故顶面 → link7 系
         z = (654.0-558.5)/1000 = +0.0955m，即顶部工具法兰面（灵巧手安装面）。
       - 法兰端面止口 r=17.5mm，灵巧手基座底部与之贴合（间隙 -0.3mm，法兰
         配合级）；第 8 轴夹爪挂接原点 0.1001 位于其电机驱动段顶部，灵巧手
         不沿用。 -->
  <xacro:arg name="rohand_xyz_ee" default="0 0 0.0955" />

  <!-- 灵巧手基座相对法兰的旋转偏置。
       留空（默认）= 按 side 自动选择安装朝向：机械臂零位时掌心朝立柱侧、
       手指沿工具方向朝下、拇指朝前偏立柱侧（left: "0 1.5708 -1.5708" /
       right: "0 1.5708 1.5708"）。显式给值则左右手统一使用该旋转。 -->
  <xacro:arg name="rohand_rpy_ee" default="" />

  <!-- 单臂模式下灵巧手使用左/右手模型（bimanual 模式自动取 left/right） -->
  <xacro:arg name="rohand_side" default="left" />

</robot>
