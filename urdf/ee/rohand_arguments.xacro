<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ROHand 灵巧手默认参数（与 openarm_hand_arguments.xacro 同风格，
       名称加 rohand_ 前缀以便 both 模式下与夹爪参数共存） -->

  <!-- 灵巧手基座相对 link7 的平移偏置。
       灵巧手安装在第 8 轴电机的"位置"上（而非电机上）：第 8 轴模块拆除后，
       灵巧手基座贴合 link7 顶端法兰面（link7 mesh 顶面 z=+0.0955，即原第 8 轴
       电机/夹爪模块的安装面），占据原电机驱动段的空间。
       参考：第 8 轴模块（hand mesh）在 link7 系 z ∈ [0.0896, 0.1206]，
       其中 [0.0896,0.0955) 为穿入 link7 的配合止口，[0.0955,~0.105) 为
       电机驱动段，[0.1056,0.1206] 为夹爪手指段。夹爪挂接原点 0.1001 位于
       电机驱动段顶部，灵巧手不可沿用（那是"装在电机上"）。 -->
  <xacro:arg name="rohand_xyz_ee" default="0 0 0.0955" />

  <!-- 灵巧手基座相对法兰的旋转偏置。
       留空（默认）= 按 side 自动选择安装朝向：机械臂零位时掌心朝立柱侧、
       手指沿工具方向朝下、拇指朝前偏立柱侧（left: "0 1.5708 -1.5708" /
       right: "0 1.5708 1.5708"）。显式给值则左右手统一使用该旋转。 -->
  <xacro:arg name="rohand_rpy_ee" default="" />

  <!-- 单臂模式下灵巧手使用左/右手模型（bimanual 模式自动取 left/right） -->
  <xacro:arg name="rohand_side" default="left" />

</robot>
