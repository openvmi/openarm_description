<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="openarm_arm_ros2_control"
         params="arm_type
             can_interface
             use_fake_hardware:=^|false
             fake_sensor_commands:=^|false
             hand:=^|false
             hand_type:=''
             dex_hand_can_id:=160
             dex_hand_master_id:=161
             dex_hand_speed:=255
             dex_hand_write_rate:=30.0
             dex_hand_poll_divider:=2
             gazebo_effort:=^|false
             arm_prefix:=''
             bimanual:=false
             can_fd:=^|false
             gravity_compensation:=true
             gravity_compensation_scale:=1.0
             payload_mass:=0.0
             payload_com_x:=0.0
             payload_com_y:=0.0
             payload_com_z:=0.0
             position_smoothing_tau:=0.1
             max_velocity_acceleration:=5.0
             ">

    <!-- 末端类型解析：hand_type 显式给出时优先；否则退回旧参数 hand(bool)。
         gripper / dex_hand / both / none -->
    <xacro:property name="eff_hand_type" value="${hand_type}"/>
    <xacro:if value="${hand_type == ''}">
      <xacro:if value="${hand}">
        <xacro:property name="eff_hand_type" value="gripper"/>
      </xacro:if>
      <xacro:unless value="${hand}">
        <xacro:property name="eff_hand_type" value="none"/>
      </xacro:unless>
    </xacro:if>
    <xacro:property name="ee_has_gripper" value="${eff_hand_type == 'gripper' or eff_hand_type == 'both'}"/>
    <xacro:property name="ee_has_dex_hand" value="${eff_hand_type == 'dex_hand' or eff_hand_type == 'both'}"/>

    <ros2_control name="openarm_hardware_interface" type="system">
        <hardware>
          <!-- Unified plugin: supports both fake and real mode.
               use_fake_hardware=true → starts in simulation mode (no CAN),
               switchable at runtime via /{node}/set_real_mode service. -->
          <plugin>openarm_hardware/OpenArm_${arm_type}HW</plugin>
          <param name="use_fake_hardware">${use_fake_hardware}</param>
          <param name="arm_type">${arm_type}</param>
          <param name="can_interface">${can_interface}</param>
          <param name="arm_prefix">${arm_prefix}</param>
          <param name="hand">${hand}</param>
          <param name="hand_type">${eff_hand_type}</param>
          <param name="can_fd">${can_fd}</param>
          <param name="gravity_compensation">${gravity_compensation}</param>
          <param name="gravity_compensation_scale">${gravity_compensation_scale}</param>
          <param name="payload_mass">${payload_mass}</param>
          <param name="payload_com_x">${payload_com_x}</param>
          <param name="payload_com_y">${payload_com_y}</param>
          <param name="payload_com_z">${payload_com_z}</param>
          <param name="position_smoothing_tau">${position_smoothing_tau}</param>
          <param name="max_velocity_acceleration">${max_velocity_acceleration}</param>
          <xacro:if value="${ee_has_dex_hand}">
            <!-- 灵巧手（raw 直通：0=完全张开, 65535=完全闭合） -->
            <param name="dex_hand_can_id">${dex_hand_can_id}</param>
            <param name="dex_hand_master_id">${dex_hand_master_id}</param>
            <param name="dex_hand_speed">${dex_hand_speed}</param>
            <param name="dex_hand_write_rate">${dex_hand_write_rate}</param>
            <param name="dex_hand_poll_divider">${dex_hand_poll_divider}</param>
          </xacro:if>
        </hardware>

      <xacro:macro name="configure_joint" params="joint_name initial_position mit_kp:=0.0 mit_kd:=0.0">
        <joint name="${joint_name}">
          <!-- Command Interfaces -->
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <!-- MIT impedance gain command interfaces (written by MITParamController) -->
          <command_interface name="kp">
            <param name="initial_value">${mit_kp}</param>
          </command_interface>
          <command_interface name="kd">
            <param name="initial_value">${mit_kd}</param>
          </command_interface>

          <!-- State Interfaces -->
          <state_interface name="position">
            <param name="initial_value">${initial_position}</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="effort">
            <param name="initial_value">0.0</param>
          </state_interface>
          <!-- MIT impedance gain state interfaces (reflect active gains) -->
          <state_interface name="kp">
            <param name="initial_value">${mit_kp}</param>
          </state_interface>
          <state_interface name="kd">
            <param name="initial_value">${mit_kd}</param>
          </state_interface>
        </joint>
      </xacro:macro>

      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint1" initial_position="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint2" initial_position="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint3" initial_position="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint4" initial_position="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint5" initial_position="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint6" initial_position="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint7" initial_position="0.0"/>

      <xacro:if value="${hand}">
        <xacro:configure_joint joint_name="openarm_${arm_prefix}finger_joint1" initial_position="0.0" />
      </xacro:if>

    </ros2_control>

  </xacro:macro>


</robot>
