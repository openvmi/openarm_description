<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openarm">

  <xacro:include filename="$(find openarm_description)/urdf/robot/openarm_robot.xacro"/>

  <xacro:arg name="arm_type" default="oy" />

  <xacro:arg name="body_type" default="oy" />

  <xacro:arg name="ee_type" default="openarm_hand" />

  <xacro:arg name="no_prefix" default="false"/>

  <xacro:arg name="hand" default="true" />

  <xacro:if value="$(eval ee_type == 'none')">
    <xacro:property name="hand" value="false"/>
  </xacro:if>

  <xacro:arg name="parent" default="world" />

  <xacro:arg name="xyz" default="0 0 0" />

  <xacro:arg name="rpy" default="0 0 0" />

  <xacro:arg name="ros2_control" default="false" />

  <xacro:arg name="can_interface" default="can0" />

  <xacro:arg name="left_can_interface" default="can1" />

  <xacro:arg name="right_can_interface" default="can0" />

  <xacro:arg name="left_arm_prefix" default="left_" />

  <xacro:arg name="right_arm_prefix" default="right_" />

  <xacro:arg name="use_fake_hardware" default="false" />

  <xacro:arg name="fake_sensor_commands" default="false" />

  <xacro:arg name="bimanual" default="false" />

  <xacro:arg name="right_arm_base_xyz" default="0.0 -0.031 0.698" />
  <xacro:arg name="right_arm_base_rpy" default="1.5708 0 0" />

  <xacro:arg name="left_arm_base_xyz" default="0.0 0.031 0.698" />
  <xacro:arg name="left_arm_base_rpy" default="-1.5708 0 0" />

  <xacro:arg name="can_fd" default="false" />

  <xacro:arg name="gravity_compensation" default="true" />

  <xacro:arg name="gravity_compensation_scale" default="1.0" />

  <xacro:arg name="payload_mass" default="0.0" />

  <xacro:arg name="payload_com_x" default="0.0" />

  <xacro:arg name="payload_com_y" default="0.0" />

  <xacro:arg name="payload_com_z" default="0.0" />

  <xacro:arg name="position_smoothing_tau" default="0.1" />

  <xacro:arg name="max_velocity_acceleration" default="5.0" />

  <!-- Optional RealSense camera attachments. Defaults off; flip to true and
       supply matching xyz/rpy from openarm_vision_bringup/config/camera_mounts.yaml
       to render the cameras in RViz and have MoveIt account for them. -->
  <xacro:arg name="attach_head_d435" default="false" />
  <xacro:arg name="head_d435_parent" default="openarm_body_link0" />
  <xacro:arg name="head_d435_xyz" default="0 0 0" />
  <xacro:arg name="head_d435_rpy" default="0 0 0" />

  <xacro:arg name="attach_left_d405" default="false" />
  <xacro:arg name="left_d405_parent" default="openarm_left_hand" />
  <xacro:arg name="left_d405_xyz" default="0 0 0" />
  <xacro:arg name="left_d405_rpy" default="0 0 0" />

  <xacro:arg name="attach_right_d405" default="false" />
  <xacro:arg name="right_d405_parent" default="openarm_right_hand" />
  <xacro:arg name="right_d405_xyz" default="0 0 0" />
  <xacro:arg name="right_d405_rpy" default="0 0 0" />

  <xacro:openarm_robot
  arm_type="oy"
  body_type="oy"
  joint_limits="${xacro.load_yaml('$(find openarm_description)/config//arm/oy/joint_limits.yaml')}"
  inertials="${xacro.load_yaml('$(find openarm_description)/config/arm/oy/inertials.yaml')}"
  kinematics="${xacro.load_yaml('$(find openarm_description)/config/arm/oy/kinematics.yaml')}"
  kinematics_link="${xacro.load_yaml('$(find openarm_description)/config/arm/oy/kinematics_link.yaml')}"
  kinematics_offset="${xacro.load_yaml('$(find openarm_description)/config/arm/oy/kinematics_offset.yaml')}"
  body_inertials="${xacro.load_yaml('$(find openarm_description)/config/body/oy/inertials.yaml')}"
  body_kinematics="${xacro.load_yaml('$(find openarm_description)/config/body/oy/kinematics.yaml')}"
  body_kinematics_link="${xacro.load_yaml('$(find openarm_description)/config/body/oy/kinematics.yaml')}"
  ee_kinematics_link="${xacro.load_yaml('$(find openarm_description)/config/hand/openarm_hand/kinematics_link.yaml')}"
  hand="$(arg hand)"
  ee_type="$(arg ee_type)"
  ros2_control="$(arg ros2_control)"
  can_interface="$(arg can_interface)"
  left_can_interface="$(arg left_can_interface)"
  right_can_interface="$(arg right_can_interface)"
  left_arm_prefix="$(arg left_arm_prefix)"
  right_arm_prefix="$(arg right_arm_prefix)"
  use_fake_hardware="$(arg use_fake_hardware)"
  fake_sensor_commands="$(arg fake_sensor_commands)"
  no_prefix="$(arg no_prefix)"
  arm_prefix=""
  body_prefix=""
  arm_connected_to="base"
  body_connected_to="world"
  bimanual="$(arg bimanual)"
  right_arm_base_xyz="$(arg right_arm_base_xyz)"
  left_arm_base_xyz="$(arg left_arm_base_xyz)"
  right_arm_base_rpy="$(arg right_arm_base_rpy)"
  left_arm_base_rpy="$(arg left_arm_base_rpy)"
  can_fd="$(arg can_fd)"
  gravity_compensation="$(arg gravity_compensation)"
  gravity_compensation_scale="$(arg gravity_compensation_scale)"
  payload_mass="$(arg payload_mass)"
  payload_com_x="$(arg payload_com_x)"
  payload_com_y="$(arg payload_com_y)"
  payload_com_z="$(arg payload_com_z)"
  position_smoothing_tau="$(arg position_smoothing_tau)"
  max_velocity_acceleration="$(arg max_velocity_acceleration)"
  attach_head_d435="$(arg attach_head_d435)"
  head_d435_parent="$(arg head_d435_parent)"
  head_d435_xyz="$(arg head_d435_xyz)"
  head_d435_rpy="$(arg head_d435_rpy)"
  attach_left_d405="$(arg attach_left_d405)"
  left_d405_parent="$(arg left_d405_parent)"
  left_d405_xyz="$(arg left_d405_xyz)"
  left_d405_rpy="$(arg left_d405_rpy)"
  attach_right_d405="$(arg attach_right_d405)"
  right_d405_parent="$(arg right_d405_parent)"
  right_d405_xyz="$(arg right_d405_xyz)"
  right_d405_rpy="$(arg right_d405_rpy)"
  />

</robot>
